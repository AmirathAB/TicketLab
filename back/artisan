#!/usr/bin/env php
<?php

use Illuminate\Foundation\Application;
use Symfony\Component\Console\Input\ArgvInput;

define('LARAVEL_START', microtime(true));

// Register the Composer autoloader...
require __DIR__.'/vendor/autoload.php';

// TicketLab : `php artisan serve` lance un `php -S` enfant qui relit le php.ini
// systeme (upload 2 Mo, post 8 Mo). Tout template/ZIP plus gros etait coupe par PHP
// avant Laravel -> le navigateur affichait "Impossible de joindre le serveur".
// On donne a l'enfant le dossier php/conf.d (limites 64 Mo) via PHP_INI_SCAN_DIR,
// variable ajoutee a la liste blanche que la commande `serve` transmet a l'enfant.
if (($_SERVER['argv'][1] ?? null) === 'serve') {
    $scanDir = ':'.__DIR__.'/php/conf.d';
    putenv('PHP_INI_SCAN_DIR='.$scanDir);
    $_ENV['PHP_INI_SCAN_DIR'] = $scanDir;
    \Illuminate\Foundation\Console\ServeCommand::$passthroughVariables[] = 'PHP_INI_SCAN_DIR';
}

// Bootstrap Laravel and handle the command...
/** @var Application $app */
$app = require_once __DIR__.'/bootstrap/app.php';

$status = $app->handleCommand(new ArgvInput);

exit($status);
